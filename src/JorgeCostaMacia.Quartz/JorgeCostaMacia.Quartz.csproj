<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Description>Quartz job-execution trace correlation — JobTrace get-or-creates the AggregateId/CorrelationId pair on the execution context, so every listener and the job itself share the same identifiers regardless of who runs first — plus WithPostgresDefaults, a clustered Postgres store configuration, and WithDefaults for its execution history bounds and its hosted scheduler</Description>
		<PackageTags>quartz,scheduling,jobs,trace,correlation,postgres,history</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Quartz" />
	</ItemGroup>

</Project>
